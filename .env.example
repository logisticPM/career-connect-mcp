# Public base URL, used in sign-in emails and export links.
APP_URL=http://localhost:3000

# Supabase project (Project Settings > API Keys). Both are safe to expose:
# the publishable key only works together with a user's own token and RLS.
# Leave them empty to run on the in-memory dev store without sign-in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# In-memory store only: every MCP call acts as this user.
DEV_USER_ID=dev-user

# The in-memory store loses data on every cold start. It is refused in production
# unless this is "true" (throwaway demos only).
ALLOW_MEMORY_STORE=false
