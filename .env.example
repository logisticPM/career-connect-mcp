# Public base URL, used to build export download links.
APP_URL=http://localhost:3000

# Local development only: every MCP call acts as this user until OAuth is wired.
DEV_USER_ID=dev-user

# The in-memory store loses data on every cold start. It is refused in production
# unless this is "true" (throwaway demos only). Real deployments use Supabase.
ALLOW_MEMORY_STORE=false
